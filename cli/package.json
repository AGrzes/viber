{
  "name": "viber-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "viber": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "prettier -c ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "debug": "^4.4.0",
    "handlebars": "^4.7.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
